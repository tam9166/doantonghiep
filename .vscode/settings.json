{
    "java.compile.nullAnalysis.mode": "disabled",
    "java.import.exclusions": [
        "**/backup_*/**",
        "**/node_modules/**",
        "**/target/**",
        "**/dist/**"
    ],
    "files.exclude": {
        "**/backup_*/**": true
    },
    "search.exclude": {
        "**/backup_*/**": true,
        "**/node_modules/**": true,
        "**/target/**": true,
        "**/dist/**": true
    },
    "files.watcherExclude": {
        "**/backup_*/**": true,
        "**/node_modules/**": true,
        "**/target/**": true,
        "**/dist/**": true
    }
}
