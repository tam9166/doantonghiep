# Copy this file to .env on the target machine. Do not commit the resulting .env file.
# SQL Server connection. Use a SQL Server login that can access RestaurantDB.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=RestaurantDB;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true
DB_USERNAME=your_sql_server_username
DB_PASSWORD=your_sql_server_password

# Generate a random value of at least 32 characters. Never reuse a production secret.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional integrations. Leave blank when they are not configured.
GEMINI_API_KEY=
PAYMENT_WEBHOOK_SECRET=
CAPTCHA_SECRET=

# Optional invoice email delivery. Keep INVOICE_EMAIL_ENABLED=false until SMTP is configured.
INVOICE_EMAIL_ENABLED=false
INVOICE_EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
